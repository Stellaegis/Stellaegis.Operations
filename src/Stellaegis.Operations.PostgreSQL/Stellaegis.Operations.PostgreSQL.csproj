<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Operations.PostgreSQL</RootNamespace>
    <PackageId>Stellaegis.Operations.PostgreSQL</PackageId>
    <Description>PostgreSQL stores for Stellaegis.Operations (schema ops): the jobs, claimed atomically by the workers, and the schedules with their occurrences; the declaration of the module's database for its installation and its verification.</Description>
    <PackageTags>stellaegis;operations;jobs;scheduler;postgresql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Stellaegis.Primitives.Data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Operations\Stellaegis.Operations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
